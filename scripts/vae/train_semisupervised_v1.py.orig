"""
Approach 1: Semi-Supervised Fresh Ratings Causal Training Pipeline
Multi-Task Forward-Transition Guided VAE (FT-VAE) + Fresh-Fit Gradient Boosted Predictor
Master's Thesis: Monitoring Credit Ratings with E-Variables
"""

import os
import sys
import time
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
import numpy as np
import pandas as pd
import lightgbm as lgb
from sklearn.preprocessing import StandardScaler
import torch
import torch.nn as nn
import torch.optim as optim
from torch.utils.data import DataLoader, TensorDataset

ORDERED_CLASSES = ['AAA', 'AA', 'A', 'BBB', 'BB', 'B']
RATING_ORDER = {'AAA': 0, 'AA': 1, 'A': 2, 'BBB': 3, 'BB': 4, 'B': 5}

EXCLUDE_COLUMNS = {
    'isin', 'cusip', 'bondsym', 'compsym', 'dates', 'date', 'rtg', 'nrtg', 
    'enc_y', 'nextdate', 'nextret', 'nextretexc', 'nextretwins', 'nextretexcwins', 
    'convertflg', 'mom6xrtg', 'permno_CORPTBL', 'PERMNO_permno', 'PERMCO_permco', 'id', 'sic',
    'prev_rtg', 'prev_enc_y', 'is_fresh_rating', 'is_downgrade', 'future_downgrade_12m'
}


class SemiSupervisedFTVAE(nn.Module):
    """
    Jointly reconstructs financial features in latent space z and predicts
    future rating transitions (y_{t+K}) to structure latent representations
    around credit deterioration.
    """
    def __init__(self, input_dim: int, num_classes: int = 6, latent_dim: int = 8, hidden_dim: int = 64):
        super(SemiSupervisedFTVAE, self).__init__()
        self.input_dim = input_dim
        self.latent_dim = latent_dim
        self.num_classes = num_classes

        # Encoder
        self.encoder = nn.Sequential(
            nn.Linear(input_dim, hidden_dim),
            nn.BatchNorm1d(hidden_dim),
            nn.LeakyReLU(0.2),
            nn.Dropout(0.1),
            nn.Linear(hidden_dim, hidden_dim // 2),
            nn.BatchNorm1d(hidden_dim // 2),
            nn.LeakyReLU(0.2)
        )
        self.fc_mu = nn.Linear(hidden_dim // 2, latent_dim)
        self.fc_logvar = nn.Linear(hidden_dim // 2, latent_dim)

        # Decoder
        self.decoder = nn.Sequential(
            nn.Linear(latent_dim, hidden_dim // 2),
            nn.BatchNorm1d(hidden_dim // 2),
            nn.LeakyReLU(0.2),
            nn.Linear(hidden_dim // 2, hidden_dim),
            nn.BatchNorm1d(hidden_dim),
            nn.LeakyReLU(0.2),
            nn.Linear(hidden_dim, input_dim)
        )

        # Auxiliary Supervised Classification Head
        self.classifier = nn.Sequential(
            nn.Linear(latent_dim, hidden_dim // 2),
            nn.LeakyReLU(0.2),
            nn.Dropout(0.1),
            nn.Linear(hidden_dim // 2, num_classes)
        )

    def encode(self, x):
        h = self.encoder(x)
        return self.fc_mu(h), self.fc_logvar(h)

    def reparameterize(self, mu, logvar):
        std = torch.exp(0.5 * torch.clamp(logvar, min=-10.0, max=5.0))
        eps = torch.randn_like(std)
        return mu + eps * std

    def decode(self, z):
        return self.decoder(z)

    def forward(self, x):
        mu, logvar = self.encode(x)
        z = self.reparameterize(mu, logvar)
        recon_x = self.decode(z)
        logits = self.classifier(mu)
        return recon_x, mu, logvar, logits


def select_features_and_momentum(df: pd.DataFrame) -> tuple:
    candidate_cols = []
    for col in df.columns:
        col_lower = col.strip().lower()
        if col_lower in EXCLUDE_COLUMNS or col in EXCLUDE_COLUMNS:
            continue
        if 'next' in col_lower or 'ret' in col_lower or 'id' in col_lower:
            continue
        if pd.api.types.is_numeric_dtype(df[col]):
            missing_ratio = df[col].isnull().mean()
            if missing_ratio <= 0.35:
                candidate_cols.append(col)

    # Momentum / Delta features
    key_features = ['spread', 'yield', 'duration', 'volatility', 'VaR', 'D2D', 'debt_ebitda', 'sales', 'leverage']
    available_keys = [c for c in key_features if c in df.columns]

    delta_cols = []
    for k in available_keys:
        d6 = f'{k}_delta6m'
        d12 = f'{k}_delta12m'
        df[d6] = df.groupby('isin')[k].diff(6).fillna(0.0)
        df[d12] = df.groupby('isin')[k].diff(12).fillna(0.0)
        delta_cols.extend([d6, d12])

    all_features = candidate_cols + delta_cols
    df[all_features] = df[all_features].fillna(0.0)
    return df, all_features


def run_semi_supervised_fresh_pipeline(
    raw_data_path: str = './CorpBond_Reconciling/corp_jkp_mergedv2.csv',
    output_csv_path: str = './results/semi_supervised_fresh_inference_results.csv',
    min_train_snapshots: int = 24
):
    t0 = time.time()
    print("====================================================================")
    print("   STARTING SEMI-SUPERVISED FRESH RATINGS CAUSAL PIPELINE")
    print("====================================================================")
    print(f"Loading raw data from: {raw_data_path}")
    raw_data = pd.read_csv(raw_data_path, low_memory=False)

    raw_data['dates'] = pd.to_datetime(raw_data['dates'].astype(str), format='%Y%m', errors='coerce')
    df = raw_data[raw_data['rtg'].isin(ORDERED_CLASSES)].copy()
    df['enc_y'] = df['rtg'].map(RATING_ORDER)
    df['isin'] = df['isin'].fillna(df['cusip'] if 'cusip' in df.columns else df['bond_id'])
    df = df.dropna(subset=['dates', 'isin', 'enc_y']).sort_values(['isin', 'dates']).reset_index(drop=True)

    # 1. Monitored Rating R_{i, t-1} vs New Rating R_{i, t}
    df['prev_rtg'] = df.groupby('isin')['rtg'].shift(1)
    df['prev_enc_y'] = df.groupby('isin')['enc_y'].shift(1).fillna(df['enc_y'])
    df['is_fresh_rating'] = df['prev_rtg'].isna() | (df['rtg'] != df['prev_rtg'])
    df['is_downgrade'] = (df['enc_y'] > df['prev_enc_y']).astype(int).fillna(0)
    df['is_rating_change'] = (df['enc_y'] != df['prev_enc_y']).astype(int)

    # Future 12m downgrade ground-truth (causal evaluation)
    df['future_downgrade_12m'] = df.groupby('isin')['is_downgrade'].transform(
        lambda s: s.iloc[::-1].rolling(12, min_periods=1).max().iloc[::-1].shift(-1)
    ).fillna(0).astype(int)

    # 2. Build Features & Momentum
    df, feature_cols = select_features_and_momentum(df)
    df = df.sort_values(['dates', 'isin']).reset_index(drop=True)

    unique_dates = sorted(df['dates'].unique())
    total_snapshots = len(unique_dates)
    print(f"Dataset: {len(df):,} bond-months | {df['isin'].nunique():,} unique ISINs")
    print(f"Fresh rating events: {df['is_fresh_rating'].sum():,} ({df['is_fresh_rating'].mean()*100:.2f}%)")
    print(f"Features: {len(feature_cols)} metrics across {total_snapshots} snapshots")
    print(f"Causal Expanding Filtration: Past Fresh Events in F_{{t-1}}\n")

    lgb_params = {
        'objective': 'multiclass',
        'num_class': 6,
        'learning_rate': 0.04,
        'num_leaves': 63,
        'min_child_samples': 15,
        'class_weight': 'balanced',
        'feature_fraction': 0.85,
        'bagging_fraction': 0.85,
        'bagging_freq': 1,
        'verbose': -1,
        'n_jobs': 4,
        'random_state': 42
    }

    input_dim = len(feature_cols)
    vae_model = SemiSupervisedFTVAE(input_dim=input_dim, num_classes=6, latent_dim=8, hidden_dim=64)
    vae_optimizer = optim.AdamW(vae_model.parameters(), lr=1e-3, weight_decay=1e-4)

    all_records = []
    lgb_model = None

    for t_idx in range(min_train_snapshots, total_snapshots):
        cur_date = unique_dates[t_idx]
        train_end_date = unique_dates[t_idx - 1]

        # All historical data up to t-1
        train_history = df[df['dates'] <= train_end_date]
        
        # FRESH RATINGS (all past fresh events) + STABLE CAUSAL ANCHORS (from t-1)
        fresh_train = train_history[train_history['is_fresh_rating'] == True]
        quiescent_anchors = train_history[(train_history['dates'] == train_end_date) & (train_history['is_fresh_rating'] == False)]
        
        if len(quiescent_anchors) > 0:
            sampled_anchors = quiescent_anchors.sample(n=min(len(fresh_train), len(quiescent_anchors)), random_state=42)
            effective_train = pd.concat([fresh_train, sampled_anchors], ignore_index=True)
        else:
            effective_train = fresh_train

        test_data = df[df['dates'] == cur_date].copy().reset_index(drop=True)

        X_train_raw = effective_train[feature_cols].values.astype(np.float32)
        y_train = effective_train['enc_y'].values.astype(np.int64)
        X_test_raw = test_data[feature_cols].values.astype(np.float32)
        y_test_monitored = test_data['prev_enc_y'].values.astype(np.int64)

        scaler = StandardScaler()
        X_train_scaled = np.nan_to_num(scaler.fit_transform(X_train_raw), nan=0.0, posinf=0.0, neginf=0.0)
        X_test_scaled = np.nan_to_num(scaler.transform(X_test_raw), nan=0.0, posinf=0.0, neginf=0.0)

        # 1. Fresh-Fit LightGBM Fit (updated every 6 snapshots for high efficiency & stability)
        if lgb_model is None or (t_idx - min_train_snapshots) % 6 == 0:
            train_ds = lgb.Dataset(X_train_raw, label=y_train)
            lgb_model = lgb.train(lgb_params, train_ds, num_boost_round=120)

        probs_lgb = lgb_model.predict(X_test_raw)

        # 2. Semi-Supervised FT-VAE Training
        epochs = 6 if t_idx == min_train_snapshots else 1
        train_loader = DataLoader(
            TensorDataset(torch.tensor(X_train_scaled, dtype=torch.float32), torch.tensor(y_train)), 
            batch_size=128, 
            shuffle=True
        )
        
        vae_model.train()
        for _ in range(epochs):
            for bx, by in train_loader:
                if bx.size(0) <= 2:
                    continue
                vae_optimizer.zero_grad()
                rx, mu, lv, lg = vae_model(bx)
                recon_l = nn.functional.mse_loss(rx, bx, reduction='none').sum(dim=1).mean()
                kl_l = -0.5 * torch.sum(1 + lv - mu.pow(2) - lv.exp(), dim=1).mean()
                ce_l = nn.functional.cross_entropy(lg, by)
                loss = recon_l + 0.05 * kl_l + 2.5 * ce_l
                loss.backward()
                vae_optimizer.step()

        vae_model.eval()
        with torch.no_grad():
            X_test_tensor = torch.tensor(X_test_scaled, dtype=torch.float32)
            rx_test, mu_test, _, lg_test = vae_model(X_test_tensor)
            recon_errs = torch.mean((rx_test - X_test_tensor)**2, dim=1).numpy()
            probs_vae = torch.softmax(lg_test, dim=1).numpy()
            latent_z = mu_test.numpy()

        # Calibrated Ensemble
        final_probs = 0.70 * probs_lgb + 0.30 * probs_vae

        # Compute Directional Deviation relative to MONITORED rating R_{i, t-1}
        enc_vec = np.arange(6)
        expected_rtg = np.dot(final_probs, enc_vec)
        directional_deviation = expected_rtg - y_test_monitored

        # Downgrade Tail Mass (P(R > R_{i, t-1}))
        down_tail_prob = np.zeros(len(test_data))
        for i in range(len(test_data)):
            c = y_test_monitored[i]
            if c < 5:
                down_tail_prob[i] = np.sum(final_probs[i, c+1:])

        # Randomized PIT
        cum_probs = np.cumsum(final_probs, axis=1)
        f_lower = np.zeros(len(test_data))
        valid_mask = y_test_monitored > 0
        f_lower[valid_mask] = cum_probs[np.arange(len(test_data))[valid_mask], y_test_monitored[valid_mask] - 1]
        p_realized = final_probs[np.arange(len(test_data)), y_test_monitored]
        v_rand = np.random.uniform(0.0, 1.0, size=len(test_data))
        randomized_pit = f_lower + v_rand * p_realized

        test_data['expected_rtg'] = expected_rtg
        test_data['anomaly_score'] = recon_errs
        test_data['directional_deviation'] = directional_deviation
        test_data['downgrade_tail_prob'] = down_tail_prob
        test_data['randomized_pit'] = randomized_pit

        for k in range(min(4, latent_z.shape[1])):
            test_data[f'latent_z_{k}'] = latent_z[:, k]

        for c_idx, c_name in enumerate(ORDERED_CLASSES):
            test_data[f'prob_class_{c_name}'] = final_probs[:, c_idx]

        all_records.append(test_data)

        if (t_idx + 1) % 24 == 0 or t_idx == total_snapshots - 1:
            print(f"  Processed Snapshot: {cur_date.strftime('%Y-%m')} [{t_idx + 1}/{total_snapshots}] | DD mean: {np.mean(directional_deviation):.3f} | Elapsed: {time.time()-t0:.1f}s")

    out_df = pd.concat(all_records, ignore_index=True)
    base_cols = [
        'isin', 'dates', 'rtg', 'enc_y', 'prev_rtg', 'prev_enc_y',
        'is_fresh_rating', 'is_downgrade', 'is_rating_change', 'future_downgrade_12m',
        'expected_rtg', 'anomaly_score', 'directional_deviation', 'downgrade_tail_prob', 'randomized_pit'
    ]
    latent_cols = [f'latent_z_{k}' for k in range(4)]
    prob_cols = [f'prob_class_{c}' for c in ORDERED_CLASSES]
    final_cols = base_cols + latent_cols + prob_cols

    out_df = out_df[final_cols]
    os.makedirs(os.path.dirname(output_csv_path), exist_ok=True)
    out_df.to_csv(output_csv_path, index=False)
    out_df.to_csv('./results/sequential_f_t_minus_1_vae_results.csv', index=False)

    print("\n====================================================================")
    print("Pipeline Complete! Semi-supervised causal inference saved to:")
    print(f"  - {output_csv_path}")
    print("  - ./results/sequential_f_t_minus_1_vae_results.csv")
    print(f"Total Rows: {len(out_df):,} | Unique Bonds: {out_df['isin'].nunique():,}")
    print(f"Total Elapsed Time: {time.time()-t0:.1f}s")
    print("====================================================================\n")
    return out_df


if __name__ == '__main__':
    run_semi_supervised_fresh_pipeline()
